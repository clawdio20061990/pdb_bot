{
  "name": "pdb-bot",
  "version": "0.2.0",
  "private": true,
  "description": "Telegram social-coordinator bot: grounded venue search in Gdańsk (Gemini + Google Maps), personalized & translated invitations, review before send.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "users:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-users.ts",
    "try": "node --env-file-if-exists=.env --import tsx scripts/try-pipeline.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
