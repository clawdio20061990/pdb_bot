# Copy to .env for local development (never commit .env).
BOT_TOKEN=123456:telegram-bot-token-from-BotFather
GEMINI_API_KEY=your-gemini-api-key
# Neon pooled connection string (the "-pooler" host). Migrations automatically use the direct host.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
GEMINI_MODEL=gemini-3.6-flash

# Webhook mode (Render sets RENDER_EXTERNAL_URL automatically). Without a URL the bot uses long polling,
# which REMOVES the production webhook for this token — use a separate test bot token locally.
# WEBHOOK_URL=https://pdb-bot.onrender.com
# WEBHOOK_SECRET=any-16+-chars-of-A-Za-z0-9_-
# PORT=3000

# Running locally against the PRODUCTION database? Set this so your laptop doesn't process production jobs
# (better: create a Neon branch for development and point DATABASE_URL at it).
# WORKER_ENABLED=false

# Google documents Maps grounding as English-only; it works in other languages too (default: the reader's language).
# GROUNDING_IN_USER_LANGUAGE=true

# Defaults (POC is Gdańsk-only):
# CITY_NAME=Gdańsk
# CITY_LAT=54.352
# CITY_LNG=18.6466
# TIMEZONE=Europe/Warsaw
# WORKER_CONCURRENCY=3
